    <string name="cf_acceso_nota">Sin internet, la app no encuentra ningún servidor. Alguna app de mensajería que conecta a direcciones fijas podría seguir funcionando.</string>
    <string name="cf_esencial_propia">SIOS hace de filtro: no se puede dejar sin internet.</string>
    <string name="cf_esencial_agente">Termux es donde funciona el agente de SIOS. Va fuera del filtro para que nunca se quede sin red.</string>
    <string name="cf_esencial_google">Google Play y sus servicios llevan las notificaciones, las cuentas y las actualizaciones. Van fuera del filtro para que nunca se queden sin red.</string>
    <string name="cf_esencial_telefonia">Telefonía: SMS, MMS, llamadas por wifi y datos del operador. Va fuera del filtro para que nunca se quede sin red.</string>
    <string name="cf_esencial_sistema">Parte del sistema (la hora, la comprobación de la conexión, las descargas). Va fuera del filtro para que nunca se quede sin red.</string>
    <string name="cf_confirmar_titulo">¿Quitar internet a %1$s?</string>
    <string name="cf_confirmar_agente">Es donde funciona el agente de SIOS: sin internet, la IA dejará de contestar y de hacer cosas por ti.</string>
    <string name="cf_confirmar_google">Muchas apps dependen de él: dejarían de llegar notificaciones y fallarían las cuentas de Google, la ubicación y las actualizaciones.</string>
    <string name="cf_confirmar_telefonia">Pueden dejar de funcionar los MMS, las llamadas por wifi y los ajustes del operador.</string>
    <string name="cf_confirmar_sistema">Dejarán de funcionar partes del sistema: la hora automática, la comprobación de la conexión y las descargas.</string>
    <string name="cf_confirmar_quitar">Quitar internet</string>


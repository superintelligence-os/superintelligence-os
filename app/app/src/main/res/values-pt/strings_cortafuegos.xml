    <string name="cf_aviso_revocado">Desligou-se porque outra VPN se ligou, ou porque foi desligada nas definições do sistema.</string>
    <string name="cf_volver_encender">Voltar a ligar</string>
    <string name="cf_aviso_error">Não foi possível ligá-la. Se outra app estiver definida como «VPN sempre ativa», retira-a nas definições de VPN.</string>
    <string name="cf_ajustes_vpn">Definições de VPN</string>
    <string name="cf_aviso_dns_privado">O DNS privado (%1$s) passa ao lado da firewall: neste momento não se filtra nada.</string>
    <string name="cf_dns_automatico">Usar DNS privado automático</string>
    <string name="cf_aviso_bloqueo">«Bloquear ligações sem VPN» está ativado: as apps essenciais, que a firewall deixa de fora para nunca ficarem sem rede, não terão internet.</string>
    <string name="cf_aviso_siempre">«VPN sempre ativa» está definida para a firewall, por isso o Android vai voltar a ligá-la. Retira-a nas definições de VPN para a desligar de vez.</string>
    <string name="cf_otra_vpn_titulo">Já há outra VPN ligada</string>
    <string name="cf_otra_vpn_nota">O Android só permite uma VPN de cada vez: se ligares a firewall, a outra desliga-se. Quando a voltares a ligar, a firewall desliga-se sozinha.</string>
    <string name="cf_encender_igualmente">Ligar mesmo assim</string>

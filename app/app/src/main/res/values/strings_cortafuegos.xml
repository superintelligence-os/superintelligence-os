    <string name="cf_estado_encendiendo">Turning on…</string>
    <string name="cf_intro">Blocks ads and trackers in every app and lets you decide which apps use the internet, on Wi‑Fi and on mobile data. It all happens on the phone: there’s no server in between.</string>

    <string name="cf_g_acceso">Internet access</string>
    <string name="cf_acceso_wifi">Wi‑Fi</string>
    <string name="cf_acceso_datos">Mobile data</string>
    <string name="cf_acceso_nota">Without internet, the app can’t find any server. A messaging app that connects to fixed addresses might still work.</string>
    <string name="cf_esencial_propia">SIOS does the filtering: it can’t be left without internet.</string>
    <string name="cf_esencial_agente">Termux is where the SIOS agent runs. It stays outside the filter so it never loses its connection.</string>
    <string name="cf_esencial_google">Google Play and its services carry notifications, accounts and updates. They stay outside the filter so they never lose their connection.</string>
    <string name="cf_esencial_telefonia">Telephony: SMS, MMS, Wi‑Fi calling and carrier data. It stays outside the filter so it never loses its connection.</string>
    <string name="cf_esencial_sistema">Part of the system (time, connection checks, downloads). It stays outside the filter so it never loses its connection.</string>
    <string name="cf_confirmar_titulo">Cut the internet for %1$s?</string>
    <string name="cf_confirmar_agente">It’s where the SIOS agent runs: without internet, the AI will stop answering and doing things for you.</string>
    <string name="cf_confirmar_google">Many apps depend on it: notifications would stop arriving, and Google accounts, location and updates would fail.</string>
    <string name="cf_confirmar_telefonia">MMS, Wi‑Fi calling and carrier settings may stop working.</string>
    <string name="cf_confirmar_sistema">Parts of the system will stop working: automatic time, connection checks and downloads.</string>
    <string name="cf_confirmar_quitar">Cut the internet</string>


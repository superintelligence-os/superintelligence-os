    <string name="cf_aviso_revocado">It turned off because another VPN connected, or it was disconnected in the system settings.</string>
    <string name="cf_volver_encender">Turn it back on</string>
    <string name="cf_aviso_error">It couldn’t turn on. If another app is set as “Always-on VPN”, remove it in the VPN settings.</string>
    <string name="cf_ajustes_vpn">VPN settings</string>
    <string name="cf_aviso_dns_privado">Private DNS (%1$s) bypasses the firewall: nothing is being filtered right now.</string>
    <string name="cf_dns_automatico">Use automatic private DNS</string>
    <string name="cf_aviso_bloqueo">“Block connections without VPN” is on: the essential apps, which the firewall leaves outside so they never lose their connection, won’t have internet.</string>
    <string name="cf_aviso_siempre">“Always-on VPN” is set for the firewall, so Android will turn it back on. Remove it in the VPN settings to turn it off for good.</string>
    <string name="cf_otra_vpn_titulo">Another VPN is already connected</string>
    <string name="cf_otra_vpn_nota">Android only allows one VPN at a time: if you turn on the firewall, the other one will disconnect. When you connect it again, the firewall will turn off by itself.</string>
    <string name="cf_encender_igualmente">Turn on anyway</string>
    <string name="cf_cancelar">Cancel</string>


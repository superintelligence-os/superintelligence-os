    <string name="bv_salud_g_filtradas_nota">They’ve appeared in data breaches: attackers try them first.</string>
    <string name="bv_salud_g_repetidas">Reused</string>
    <string name="bv_salud_g_repetidas_nota">The same password on several accounts: if one leaks, they all fall.</string>

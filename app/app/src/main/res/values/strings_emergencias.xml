    <string name="em_caidas_titulo">Fall detection</string>
    <string name="em_caidas_nota">If the phone senses a hard fall and you stay still, it asks if you’re OK and, if you don’t respond, gets help.</string>
    <string name="em_caidas_activar">Detect falls</string>
    <string name="em_caidas_activa">On</string>
    <string name="em_caidas_apagada">Off</string>
    <string name="em_caidas_sin_sensor">This phone has no accelerometer.</string>
    <string name="em_caidas_exp_1_titulo">How it works</string>
    <string name="em_caidas_exp_1">The accelerometer looks for the pattern of a fall: free fall, a hard impact and then staying still. It all happens on the phone.</string>
    <string name="em_caidas_exp_2_titulo">If you don’t respond</string>
    <string name="em_caidas_exp_2">An alarm sounds with “Are you OK?”. If you don’t stop it in time, it calls %1$s and sends your location to your contacts.</string>
    <string name="em_caidas_exp_3_titulo">It can be wrong</string>
    <string name="em_caidas_exp_3">If you drop your phone, it may go off: tap “I’m OK”. And it won’t notice every fall.</string>
    <string name="em_caidas_exp_4_titulo">Battery</string>
    <string name="em_caidas_consumo_bajo">Low use: this phone keeps the readings in its sensor chip and only wakes up every few seconds.</string>
    <string name="em_caidas_consumo_medio">Somewhat more use: this phone’s sensor chip holds few readings and wakes it often.</string>
    <string name="em_caidas_consumo_limitado">This phone can’t watch with the screen off without using a lot of battery: it will only notice falls while it’s awake.</string>
